{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EngineeringOS Experience v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "date",
    "project",
    "task",
    "status",
    "provenance",
    "actors",
    "tools",
    "evidence",
    "lessons",
    "privacy"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])"
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "task": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "status": {
      "enum": [
        "HYPOTHESIS",
        "AGENT_REPORTED",
        "USER_REPORTED",
        "SOURCE_REVIEWED",
        "LOCAL_TEST_VERIFIED",
        "CI_VERIFIED",
        "HUMAN_NATIVE_ACCEPTED",
        "PO_DECISION",
        "SYNTHETIC_FIXTURE"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "origin",
        "source_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "origin": {
          "type": "string",
          "pattern": "\\S"
        },
        "source_ref": {
          "type": "string",
          "pattern": "\\S"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "identity"
        ],
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "pattern": "\\S"
          },
          "identity": {
            "type": "string",
            "pattern": "\\S"
          },
          "independent_context": {
            "type": "boolean"
          }
        }
      },
      "minItems": 1
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "\\S"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "hypothesis",
              "agent_report",
              "user_report",
              "source_review",
              "local_test",
              "ci_run",
              "human_acceptance",
              "owner_decision",
              "synthetic_fixture"
            ]
          },
          "description": {
            "type": "string",
            "pattern": "\\S"
          },
          "reference": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      },
      "minItems": 1
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "privacy": {
      "enum": [
        "PUBLIC_REUSABLE",
        "PROJECT_INTERNAL",
        "SENSITIVE",
        "SECRET"
      ]
    },
    "reviewed_for_publication": {
      "type": "boolean"
    },
    "applies_to": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "HYPOTHESIS"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "contains": {
              "properties": {
                "type": {
                  "const": "hypothesis"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "AGENT_REPORTED"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "contains": {
              "properties": {
                "type": {
                  "const": "agent_report"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "USER_REPORTED"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "contains": {
              "properties": {
                "type": {
                  "const": "user_report"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "SOURCE_REVIEWED"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "contains": {
              "properties": {
                "type": {
                  "const": "source_review"
                }
              },
              "required": [
                "reference"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "LOCAL_TEST_VERIFIED"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "contains": {
              "properties": {
                "type": {
                  "const": "local_test"
                }
              },
              "required": [
                "reference"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "CI_VERIFIED"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "contains": {
              "properties": {
                "type": {
                  "const": "ci_run"
                }
              },
              "required": [
                "reference"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "HUMAN_NATIVE_ACCEPTED"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "contains": {
              "properties": {
                "type": {
                  "const": "human_acceptance"
                }
              },
              "required": [
                "reference"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "PO_DECISION"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "contains": {
              "properties": {
                "type": {
                  "const": "owner_decision"
                }
              },
              "required": [
                "reference"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "SYNTHETIC_FIXTURE"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "items": {
              "properties": {
                "type": {
                  "const": "synthetic_fixture"
                },
                "reference": {
                  "type": "string",
                  "pattern": "^fixture:"
                }
              }
            }
          },
          "id": {
            "pattern": "^SYNTHETIC-"
          },
          "provenance": {
            "properties": {
              "origin": {
                "const": "synthetic fixture"
              },
              "source_ref": {
                "pattern": "^fixture:"
              }
            }
          },
          "actors": {
            "items": {
              "properties": {
                "independent_context": {
                  "const": false
                }
              }
            }
          },
          "tools": {
            "items": {
              "properties": {
                "source_ref": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^fixture:"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "id": {
            "pattern": "^SYNTHETIC-"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "SYNTHETIC_FIXTURE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provenance": {
            "properties": {
              "source_ref": {
                "pattern": "^fixture:"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "SYNTHETIC_FIXTURE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence": {
            "contains": {
              "properties": {
                "type": {
                  "const": "synthetic_fixture"
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "SYNTHETIC_FIXTURE"
          }
        }
      }
    }
  ]
}
